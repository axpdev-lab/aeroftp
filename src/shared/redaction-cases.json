[
  {
    "name": "basic header",
    "input": "Authorization: Basic dXNlcjpwYXNz",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "basic header with padding",
    "input": "Authorization: Basic dXNlcjpwYQ==",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "bearer header",
    "input": "Authorization: Bearer abcdefghijklmnop",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "digest header dump",
    "input": "authorization=Digest username=\"a\", realm=\"b\", response=\"c\"",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "ntlm header",
    "input": "Authorization: NTLM TlRMTVNTUAABAAAAB4IIogAAAAAAAAAAAAAAAAAAAAAGAHAXAAAADw==",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "negotiate header",
    "input": "Authorization: Negotiate YIIBVgYGKwYBBQUCoIIBSjCCAUagDTALBgkqhkiG9xIBAgIFAKIDAgEW",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "custom scheme with parameters",
    "input": "Authorization: Hawk id=\"dh37fgj492je\", ts=\"1353832234\", mac=\"6R4rV5iE+NPoym+WwjeHzjAGXUtLNIxmo1vpMofpLAE=\"",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "credential without a scheme",
    "input": "authorization: abc123token",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "proxy header at the end of the line",
    "input": "proxy-authorization: Basic dXNlcjpwYXNz",
    "expected": "proxy-authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "text on both sides",
    "input": "sent Authorization: Basic dXNlcjpwYXNz to host",
    "expected": "sent authorization: ***REDACTED*** to host",
    "group": "authorization"
  },
  {
    "name": "neighbouring headers survive",
    "input": "host: a.example.org authorization: Basic dXNlcjpwYXNz user-agent: x",
    "expected": "host: a.example.org authorization: ***REDACTED*** user-agent: x",
    "group": "authorization"
  },
  {
    "name": "composes with the other rules",
    "input": "user bob@example.org sent Authorization: Basic dXNlcjpwYXNz",
    "expected": "user ***@*** sent authorization: ***REDACTED***"
  },
  {
    "name": "quoted value after a plain key",
    "input": "authorization: \"Bearer abcdefghijklmnop\"",
    "expected": "authorization: \"***REDACTED***\"",
    "group": "authorization"
  },
  {
    "name": "json field keeps the next keys",
    "input": "{\"authorization\":\"Basic dXNlcjpwYXNz\",\"next\":1}",
    "expected": "{\"authorization\":\"***REDACTED***\",\"next\":1}",
    "group": "authorization"
  },
  {
    "name": "json field with spaces",
    "input": "{\"Authorization\": \"Basic dXNlcjpwYXNz\", \"host\": \"example.org\"}",
    "expected": "{\"Authorization\": \"***REDACTED***\", \"host\": \"example.org\"}",
    "group": "authorization"
  },
  {
    "name": "json digest with escaped quotes",
    "input": "{\"authorization\":\"Digest username=\\\"a\\\", response=\\\"c\\\"\",\"next\":1}",
    "expected": "{\"authorization\":\"***REDACTED***\",\"next\":1}",
    "group": "authorization"
  },
  {
    "name": "json cut before its closing quote",
    "input": "{\"authorization\":\"Basic dXNlcjpw",
    "expected": "{\"authorization\":\"***REDACTED***\"",
    "group": "authorization"
  },
  {
    "name": "json inside a json string",
    "input": "{\"msg\":\"{\\\"authorization\\\":\\\"Basic dXNlcjpwYXNz\\\",\\\"next\\\":1}\"}",
    "expected": "{\"msg\":\"{\\\"authorization\\\":\\\"***REDACTED***\\\",\\\"next\\\":1}\"}",
    "group": "authorization"
  },
  {
    "name": "digest inside a json string",
    "input": "{\"msg\":\"{\\\"authorization\\\":\\\"Digest username=\\\\\\\"a\\\\\\\", response=\\\\\\\"c\\\\\\\"\\\",\\\"next\\\":1}\"}",
    "expected": "{\"msg\":\"{\\\"authorization\\\":\\\"***REDACTED***\\\",\\\"next\\\":1}\"}",
    "group": "authorization"
  },
  {
    "name": "digest inside a json string with a backslash in a parameter",
    "input": "{\"payload\":\"{\\\"authorization\\\":\\\"Digest username=\\\\\\\"a\\\\\\\\b\\\\\\\", response=\\\\\\\"S3cretVal42\\\\\\\"\\\"}\"}",
    "expected": "{\"payload\":\"{\\\"authorization\\\":\\\"***REDACTED***\\\"}\"}",
    "group": "authorization"
  },
  {
    "name": "the word alone is prose",
    "input": "authorization failed for the session",
    "expected": "authorization failed for the session",
    "group": "authorization"
  },
  {
    "name": "bearer token on its own",
    "input": "retry with Bearer abcdefghijklmnop failed",
    "expected": "retry with Bearer ***REDACTED*** failed"
  },
  {
    "name": "public ipv4",
    "input": "peer 192.168.1.20 answered",
    "expected": "peer ***.***.***.*** answered"
  },
  {
    "name": "loopback and unspecified ipv4 stay",
    "input": "listening on 127.0.0.1 and 0.0.0.0",
    "expected": "listening on 127.0.0.1 and 0.0.0.0"
  },
  {
    "name": "an address that only starts like loopback",
    "input": "from 127.0.0.10 and 0.0.0.01",
    "expected": "from ***.***.***.*** and ***.***.***.***"
  },
  {
    "name": "ipv4 with a port",
    "input": "connect 10.0.0.5:2121 refused",
    "expected": "connect ***.***.***.***:2121 refused"
  },
  {
    "name": "json secret field",
    "input": "{\"password\":\"hunter2\",\"user\":\"bob\"}",
    "expected": "{\"password\":\"***REDACTED***\",\"user\":\"bob\"}"
  },
  {
    "name": "aws sigv4 header",
    "input": "Authorization: AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/iam/aws4_request, SignedHeaders=content-type;host;x-amz-date, Signature=5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "key and value with a colon keeps the colon",
    "input": "password: hunter2",
    "expected": "password: ***REDACTED***"
  },
  {
    "name": "key and value with an equals sign keeps it",
    "input": "password=hunter2",
    "expected": "password=***REDACTED***"
  },
  {
    "name": "short and dashed key names",
    "input": "pass=abc123 api-key=zzz999",
    "expected": "pass=***REDACTED*** api-key=***REDACTED***"
  },
  {
    "name": "secret names with a prefix",
    "input": "client_secret=abc123 secret_key: def456 passphrase=ghi789",
    "expected": "client_secret=***REDACTED*** secret_key: ***REDACTED*** passphrase=***REDACTED***"
  },
  {
    "name": "oauth token names",
    "input": "access_token=ya29.a0AfH6SMB refresh_token: 1//0gXYZ id_token=abc",
    "expected": "access_token=***REDACTED*** refresh_token: ***REDACTED*** id_token=***REDACTED***"
  },
  {
    "name": "json oauth token fields",
    "input": "{\"access_token\":\"ya29.x\",\"expires_in\":3600}",
    "expected": "{\"access_token\":\"***REDACTED***\",\"expires_in\":3600}"
  },
  {
    "name": "a plural is not a token key",
    "input": "max_tokens=4096 and tokens: 5",
    "expected": "max_tokens=4096 and tokens: 5"
  },
  {
    "name": "an api key as the bearer token",
    "input": "Authorization: Bearer sk-ant-abcdefghijklmnopqrstuv",
    "expected": "authorization: ***REDACTED***",
    "group": "authorization"
  },
  {
    "name": "opaque credential with a colon",
    "input": "Authorization: AWS AKIAEXAMPLE:c2lnbmF0dXJl next",
    "expected": "authorization: ***REDACTED*** next",
    "group": "authorization"
  },
  {
    "name": "opaque credential with percent and at",
    "input": "Authorization: Token a%2Fb@c next",
    "expected": "authorization: ***REDACTED*** next",
    "group": "authorization"
  },
  {
    "name": "a quoted value after a key",
    "input": "password=\"secret\" next",
    "expected": "password=***REDACTED*** next"
  },
  {
    "name": "a quoted value after a colon",
    "input": "token: \"secret\" next",
    "expected": "token: ***REDACTED*** next"
  },
  {
    "name": "a single-quoted value",
    "input": "api_key='abc' next",
    "expected": "api_key=***REDACTED*** next"
  },
  {
    "name": "a quoted value cut before its closing quote",
    "input": "password=\"abc def",
    "expected": "password=***REDACTED***"
  },
  {
    "name": "a quoted x-api-key",
    "input": "x-api-key: \"abc123\" next",
    "expected": "x-api-key: ***REDACTED*** next"
  },
  {
    "name": "a json secret with an escaped quote",
    "input": "{\"password\":\"abc\\\"def\",\"user\":\"x\"}",
    "expected": "{\"password\":\"***REDACTED***\",\"user\":\"x\"}"
  },
  {
    "name": "a json x-api-key",
    "input": "{\"x-api-key\":\"abc123\",\"next\":1}",
    "expected": "{\"x-api-key\":\"***REDACTED***\",\"next\":1}"
  },
  {
    "name": "a json secret inside a json string",
    "input": "{\"msg\":\"{\\\"password\\\":\\\"abc\\\",\\\"next\\\":1}\"}",
    "expected": "{\"msg\":\"{\\\"password\\\":\\\"***REDACTED***\\\",\\\"next\\\":1}\"}"
  },
  {
    "name": "a json secret after a backslash inside a json string",
    "input": "{\"payload\":\"{\\\"password\\\":\\\"a\\\\\\\\bS3cretVal42\\\"}\"}",
    "expected": "{\"payload\":\"{\\\"password\\\":\\\"***REDACTED***\\\"}\"}"
  },
  {
    "name": "a redacted secret stays as it is",
    "input": "password: ***REDACTED***",
    "expected": "password: ***REDACTED***"
  }
]
