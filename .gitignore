# Dependencies
# No trailing slash: a worktree may carry `node_modules` as a symlink to the
# main checkout's, and `node_modules/` does not match a symlink.
node_modules

# Build outputs
dist/
src-tauri/target/
# The workspace root's own target, where `scripts/aerorsync-emit.sh` writes the
# standalone crate by default. Only `src-tauri/target/` was listed, so a
# `git add -A` after an emission staged the 6862 generated files of the crate.
/target/

# Environment files
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Testing
coverage/

# Cargo / Rust
*.rs.bk

# Tauri generated
src-tauri/gen/

# Local development files
*.local
.tauri/

# Snapcraft
*.snap
parts/
stage/
prime/

# Flatpak
.flatpak-builder/
.craft/
overlay/
flathub-fork/
snapcraft.login

# AI tool configs (developer-local)
.kilocodemodes
.orchids/

# Internal development docs and config (not for public GitHub)
docs/dev/
CLAUDE.md

# Native rsync protocol sources live in tree now. Only the
# multi-hundred-MB capture harness stays out of git (Docker images,
# rsync reference binaries, fixture transcripts too large to ship).
# Module renamed `rsync_native_proto` -> `aerorsync` on 2026-04-25.
src-tauri/src/aerorsync/capture/bin/
src-tauri/src/aerorsync/capture/artifacts/
src-tauri/src/aerorsync/capture/artifacts_deflate/
src-tauri/src/aerorsync/capture/artifacts_real/*
!src-tauri/src/aerorsync/capture/artifacts_real/frozen/
src-tauri/src/aerorsync/capture/workspace/

# Upstream rsync 3.2.7 source extracted at repo root for CVE inspection
# during the aerorsync wire saga. Reference material, not shipped.
/rsync-3.2.7/
/rsync_3.2.7*

# Kilo IDE plans / scratch
.kilo/

# Local dev scripts (hardcoded paths)
run-clean.sh

# One-time translation scripts
/scripts/i18n/

# Development scripts (root only, not .github/scripts/)
# Ignore the directory contents (not the dir itself) so the !exceptions below
# can re-include specific tracked scripts; git cannot re-include a file when its
# parent directory is excluded outright.
/scripts/*
# Exception: CI-required scripts
!/scripts/apply-i18n-batch.py
!/scripts/i18n-validate.ts
!/scripts/i18n-sync.ts
!/scripts/i18n-stats.ts
!/scripts/security-report.cjs
# Exception: bundle-required script (Tauri beforeBundleCommand)
!/scripts/prepare-dispatch-bundle.cjs
# Exception: regenerates the embedded CLI catalog from the GUI SSOT (#224)
!/scripts/gen-cli-catalog.ts
# Exception: release step, publishes a curated asset subset to SourceForge
!/scripts/publish-sourceforge.sh
# Exception: snap gates and stage-package staleness audit (#460, #462)
!/scripts/snap-abi-check.sh
!/scripts/snap-gui-check.sh
!/scripts/snap-stale-packages.mjs
# Exception: Linux ACL packaging contracts for AeroRsync (G4)
!/scripts/assert-linux-acl-packaging.sh
# Exception: re-emits the aerorsync module as a standalone crate, so the CI can
# prove with the compiler that it does not depend on the application
!/scripts/aerorsync-emit.sh
# Exception: regenerates the providers table from the GUI SSOT (#270 17104681)
!/scripts/gen-providers-table.ts
# Exception: derives every published provider/preset/protocol figure into
# docs/PROVIDER-INVENTORY.json, gated by the fast checks workflow
!/scripts/gen-provider-inventory.ts
# Exception: stripped-diacritics gate and its reviewed baseline, run by the
# fast checks workflow (#628 item 12)
!/scripts/i18n-diacritics.mjs
!/scripts/i18n-diacritics-accepted.json
# Exception: raw-English gate and its reviewed baseline, run by the fast checks
# workflow (#628 item 13)
!/scripts/i18n-untranslated.mjs
!/scripts/i18n-untranslated-accepted.json
# Exception: single pre-release smoke entrypoint (`npm run smoke`, #408 row 1)
!/scripts/smoke.mjs
# Exception: asserts a CI lane actually executed the tests it selects, called by
# ftp-mlsd, delta-sync-integration, aerorsync-protocol and nightly-telemetry
!/scripts/assert-tests-ran.sh

# Security reports: keep latest snapshot in repo, ignore dated copies
/docs/security/security-report-20*.html
/docs/security/security-report-20*.json

# Temporary output files
check_output*.txt
src-tauri/check_output*.txt

# Package manager lock files (bun)
bun.lock

# Generated/cached files
.cache/
.claude/
.github/agents/
.antigravitycli/
