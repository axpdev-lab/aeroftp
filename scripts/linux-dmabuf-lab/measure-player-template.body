// DEV-only component rendering workload, never imported by application code.
const kind=KIND,mode=MODE;
const errorsBefore=window.__row56.errors.length;
window.__row56.render(kind,mode);
const endReady=Date.now()+5000;
while(!document.querySelector('#row56-player canvas')) {if(Date.now()>endReady)throw Error('Player canvas absent');await new Promise(r=>setTimeout(r,50));}
await new Promise(r=>setTimeout(r,350));
const c=document.querySelector('#row56-player canvas'),g=kind==='webgl'?c.getContext('webgl2'):null;
if(kind==='webgl'&&!g)throw Error('No WebGL2 context');
let frames=0,previous=performance.now(),start=previous;const delta=[];
while(performance.now()-start<6000){const now=await new Promise(requestAnimationFrame);delta.push(now-previous);previous=now;frames++;}
delta.sort((a,b)=>a-b);
const glError=g?.getError(),lost=g?.isContextLost();
const program=g?.getParameter(g.CURRENT_PROGRAM);const programLinked=program?g.getProgramParameter(program,g.LINK_STATUS):null;const shaderCompiled=program?g.getAttachedShaders(program).map(s=>g.getShaderParameter(s,g.COMPILE_STATUS)):null;
const renderedText=document.querySelector("#row56-player").innerText;
let pixelSummary=null;
if(kind==='canvas') {const data=c.getContext('2d').getImageData(0,0,c.width,c.height).data;let min=255,max=0,coloured=0;for(let i=0;i<data.length;i+=4){min=Math.min(min,data[i],data[i+1],data[i+2]);max=Math.max(max,data[i],data[i+1],data[i+2]);if(Math.max(data[i],data[i+1],data[i+2])-Math.min(data[i],data[i+1],data[i+2])>25)coloured++;}pixelSummary={min,max,colouredPixels:coloured};}
const durationMs=performance.now()-start;
return {kind,mode,frames,durationMs,fps:frames/(durationMs/1000),p50:delta[Math.floor(delta.length*.5)],p95:delta[Math.floor(delta.length*.95)],over33ms:delta.filter(x=>x>33.4).length,canvas:[c.width,c.height],glError,programLinked,shaderCompiled,renderedText,contextLost:lost,contextLostEvents:window.__row56.lost.count,pixelSummary,newErrors:window.__row56.errors.slice(errorsBefore)};
