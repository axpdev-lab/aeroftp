{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AeroFTP default capabilities: file manager requires full FS access. A8-01: fs:read-all/write-all are REQUIRED because AeroFTP is a file manager that must read/write any user-chosen path. fs:scope MUST keep { \"path\": \"**\" }: the security boundary is the explicit fs:deny-webview-data-* rules, NOT a $HOME allow-list. Removing the ** entry (v2.8.7..v3.8.2 regression) broke browsing/transfer of any path outside $HOME (external drives, /mnt, /media, project trees) with 'not allowed by ACL'. Risk-accepted: removing *-all or ** would break core functionality.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-fullscreen",
    "notification:default",
    "dialog:default",
    "fs:read-all",
    "fs:write-all",
    "fs:deny-webview-data-linux",
    "fs:deny-webview-data-windows",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$TEMP/**" },
        { "path": "**" }
      ]
    },
    "log:default",
    "core:path:default",
    "shell:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "window-state:default"
  ],
  "remote": {
    "urls": [
      "asset://localhost/*",
      "http://127.0.0.1:14321/*"
    ]
  }
}
