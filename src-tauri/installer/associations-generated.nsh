!macro AeroFTPRegister_common
    ClearErrors
    WriteRegStr HKCU "Software\Classes\Applications\AeroFTP.exe\DefaultIcon" "" "$INSTDIR\icons\mimetypes\aeroftp-document.ico,0"
    IfErrors _aeroftp_registration_failed 0
    ClearErrors
    WriteRegStr HKCU "Software\Classes\Applications\AeroFTP.exe\shell\open\command" "" "$\"$INSTDIR\AeroFTP.exe$\" $\"%1$\""
    IfErrors _aeroftp_registration_failed 0
!macroend
!macro AeroFTPUnregister_common
    !insertmacro AeroFTPDeleteMatchingValue "Software\Classes\Applications\AeroFTP.exe\DefaultIcon" "" "$INSTDIR\icons\mimetypes\aeroftp-document.ico,0"
    !insertmacro AeroFTPDeleteMatchingValue "Software\Classes\Applications\AeroFTP.exe\shell\open\command" "" "$\"$INSTDIR\AeroFTP.exe$\" $\"%1$\""
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications\AeroFTP.exe\shell\open\command"
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications\AeroFTP.exe\shell\open"
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications\AeroFTP.exe\DefaultIcon"
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications\AeroFTP.exe\shell"
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications\AeroFTP.exe"
    DeleteRegKey /ifempty HKCU "Software\Classes\Applications"
!macroend
