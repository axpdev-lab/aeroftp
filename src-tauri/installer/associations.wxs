<?xml version="1.0" encoding="utf-8"?>
<!--
  AeroFTP WiX fragment: bring the MSI installer to parity with the NSIS installer
  (src-tauri/installer/hooks.nsh) for Windows OS shell integration.

  WHY THIS EXISTS
  ===============
  Tauri generates the MSI's file associations from `bundle.fileAssociations` in
  tauri.conf.json, but that auto-generation is limited: for each of the five aero*
  extensions it emits an *advertised* ProgID named `AeroFTP.<ext>` (lowercase) with a
  single "open" verb and NOTHING else - no DefaultIcon, no Content Type, and no extract
  verbs. The "Extract Here / Extract to Folder with AeroFTP" context-menu verbs and the
  mimetype icons are written only by hooks.nsh, which the MSI never runs. The MSI is a
  first-class distribution channel (every GitHub Release, the README, winget), so it must
  match the NSIS shell integration. This fragment adds the missing pieces WITHOUT
  redefining Tauri's auto-generated extensions/ProgIDs (doing so would collide and trip
  WiX ICE validation), by layering registry data alongside them.

  SCOPE DECISIONS
  ===============
  * Registry root = HKMU. The Tauri MSI is InstallScope="perMachine", so HKMU resolves
    to HKLM (machine-wide), matching the scope of the advertised associations. (For a
    perUser package it would resolve to HKCU.)
  * Extract verbs are ADDITIVE (owner decision c): we never write a default shell\open
    for the general archive formats, so their double-click handler is untouched.
      - General formats (.zip/.7z/.rar/.tar/.tgz/.gz/.xz/.bz2): the verbs attach under
        SystemFileAssociations\.<ext>, which layers on top of whatever app owns the type
        (exactly like NSIS).
      - Our own aero archive ProgIDs (AeroFTP.aerovault / AeroFTP.aerozip): the verbs sit
        next to the auto-generated "open" verb on the same advertised ProgID Tauri emits
        (lowercase name), mirroring how NSIS puts them on the ProgID it owns.
  * Mimetype icon parity: a DefaultIcon is written on each of the five auto-generated
    aero ProgIDs (which otherwise have none). The .ico files already ship as Tauri
    `resources` to [INSTALLDIR]\icons\mimetypes\.
  * Generic fallback icon (Applications\aeroftp.exe\DefaultIcon): a tidy no-badge document
    icon for any otherwise-iconless file opened with AeroFTP (mirrors the hooks.nsh entry
    for the NSIS binary AeroFTP.exe; registry keys are case-insensitive).

  The main binary is referenced as [INSTALLDIR]aeroftp.exe (a literal path built from the
  install-dir property, which carries a trailing backslash; the Tauri main executable is
  installed as aeroftp.exe). We deliberately do NOT use the WiX file reference [#Path]:
  that creates an implicit cross-component reference and trips ICE69 ("Mismatched
  component reference") because these registry components live in a different feature than
  the main-binary File component.
-->
<?if $(sys.BUILDARCH)="x64" or $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?define Win64 = "no" ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!--
          INSTALLDIR is defined in the Tauri-generated main.wxs; the linker resolves it
          across fragments. All registry-only components live under it for component
          bookkeeping (they install no files there).
        -->
        <ComponentGroup Id="AeroFTPShellIntegration" Directory="INSTALLDIR">

            <!-- ============================================================= -->
            <!-- Extract verbs - general archive formats (additive, no default) -->
            <!-- ============================================================= -->

            <Component Id="AeroFTPVerbsZip" Guid="62E0660B-F2E4-439B-9B8B-C1C0300848E8" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.zip\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbs7z" Guid="F722F87D-E100-4E72-B5B1-250E30FB30F5" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.7z\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsRar" Guid="93C8F473-242A-42B7-A2FA-FA7583526E40" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.rar\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsTar" Guid="342A8BCF-731F-4F7D-A4BA-8C23EA142545" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tar\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsTgz" Guid="CAE1AE2C-15FC-48EA-8D24-4710B9AE6D17" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tgz\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsGz" Guid="88664773-CBB0-4D40-9FC8-AC54B2C7A5A7" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gz\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsXz" Guid="0AFC784B-C237-4B4B-8735-20A9E7077155" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xz\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPVerbsBz2" Guid="FDB0789C-5E8F-45E2-B2A5-B0F5327ACAFE" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bz2\shell">
                    <RegistryKey Key="AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" KeyPath="yes" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <!-- ============================================================= -->
            <!-- Deliverable G: Archive opener (ProgID + OpenWith + Caps)     -->
            <!-- Shared AeroFTP.Archive ProgID for .zip/.7z/.rar/.tar* etc.   -->
            <!-- Makes AeroFTP appear in Open with / Default apps with the    -->
            <!-- archive mimetype icon. Never claims default handler.         -->
            <!-- ============================================================= -->

            <!-- Shared ProgID (wholly owned, ForceDeleteOnUninstall) -->
            <Component Id="AeroFTPArchiveProgId" Guid="C42F5865-15D9-4A5E-BABD-4D5E055063B5" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.Archive" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="Compressed Archive" KeyPath="yes" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp-archive.ico,0" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open">
                        <RegistryValue Type="string" Value="Open with AeroFTP" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <!-- SupportedTypes (under the Applications key already used for DefaultIcon) -->
            <Component Id="AeroFTPArchiveSupportedTypes" Guid="95769758-E722-4567-9114-AA9B057D0B5F" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\Applications\aeroftp.exe\SupportedTypes" ForceDeleteOnUninstall="yes">
                    <RegistryValue Name=".zip" Type="string" Value="" KeyPath="yes" />
                    <RegistryValue Name=".7z" Type="string" Value="" />
                    <RegistryValue Name=".rar" Type="string" Value="" />
                    <RegistryValue Name=".tar" Type="string" Value="" />
                    <RegistryValue Name=".tgz" Type="string" Value="" />
                    <RegistryValue Name=".gz" Type="string" Value="" />
                    <RegistryValue Name=".xz" Type="string" Value="" />
                    <RegistryValue Name=".bz2" Type="string" Value="" />
                </RegistryKey>
            </Component>

            <!-- Capabilities + FileAssociations (wholly owned by AeroFTP) -->
            <Component Id="AeroFTPArchiveCapabilities" Guid="B474CE34-D285-4F22-95D7-C8E6A64D01A7" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\AeroFTP\Capabilities" ForceDeleteOnUninstall="yes">
                    <RegistryValue Name="ApplicationName" Type="string" Value="AeroFTP" KeyPath="yes" />
                    <RegistryValue Name="ApplicationDescription" Type="string" Value="AeroFTP archive browser and extractor" />
                    <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp-archive.ico,0" />
                    <RegistryKey Key="FileAssociations">
                        <RegistryValue Name=".zip" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".7z" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".rar" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".tar" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".tgz" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".gz" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".xz" Type="string" Value="AeroFTP.Archive" />
                        <RegistryValue Name=".bz2" Type="string" Value="AeroFTP.Archive" />
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <!-- RegisteredApplications entry (value only) -->
            <Component Id="AeroFTPRegisteredApp" Guid="DAC938BF-06A2-4CBF-B335-D070E5DE6359" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\RegisteredApplications">
                    <RegistryValue Name="AeroFTP" Type="string" Value="Software\AeroFTP\Capabilities" KeyPath="yes" />
                </RegistryKey>
            </Component>

            <!-- OpenWithProgids values (one per ext; value-managed, no ForceDelete on parent keys) -->
            <Component Id="AeroFTPArchiveOpenWith" Guid="818490AA-795E-46E5-A5ED-26B70AFA7719" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\.zip\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" KeyPath="yes" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.7z\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.rar\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.tar\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.tgz\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.gz\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.xz\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
                <RegistryKey Root="HKMU" Key="Software\Classes\.bz2\OpenWithProgids">
                    <RegistryValue Name="AeroFTP.Archive" Type="string" Value="" />
                </RegistryKey>
            </Component>

            <!-- ============================================================= -->
            <!-- aero archive ProgIDs: DefaultIcon + extract verbs              -->
            <!-- (alongside Tauri's auto-generated advertised "open" verb)      -->
            <!-- ============================================================= -->

            <Component Id="AeroFTPProgIdAeroVault" Guid="445C0FF4-246E-446D-A17D-02AD5EBD3041" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.aerovault">
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aerovault.ico,0" KeyPath="yes" />
                    </RegistryKey>
                    <RegistryKey Key="shell\AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="shell\AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPProgIdAeroZip" Guid="D0297D5C-2624-43FD-8105-4D43227E860D" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.aerozip">
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aerozip.ico,0" KeyPath="yes" />
                    </RegistryKey>
                    <RegistryKey Key="shell\AeroFTPExtractHere" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract Here with AeroFTP" />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-here &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                    <RegistryKey Key="shell\AeroFTPExtractToFolder" ForceDeleteOnUninstall="yes">
                        <RegistryValue Type="string" Value="Extract to Folder with AeroFTP..." />
                        <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]aeroftp.exe,0" />
                        <RegistryKey Key="command">
                            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]aeroftp.exe&quot; --extract-to &quot;%1&quot;" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
            </Component>

            <!-- ============================================================= -->
            <!-- aero non-archive ProgIDs: DefaultIcon parity only             -->
            <!-- ============================================================= -->

            <Component Id="AeroFTPProgIdProfile" Guid="43A24787-63F0-4B7C-A9F5-4ED80D15A7F6" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.aeroftp\DefaultIcon">
                    <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp.ico,0" KeyPath="yes" />
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPProgIdKeystore" Guid="0E51635D-5003-44A9-B7D3-207C4B175AD7" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.aeroftp-keystore\DefaultIcon">
                    <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp-keystore.ico,0" KeyPath="yes" />
                </RegistryKey>
            </Component>

            <Component Id="AeroFTPProgIdScript" Guid="B5C1F1F2-6E42-456C-B369-60C497430D46" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\AeroFTP.aeroftp-script\DefaultIcon">
                    <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp-script.ico,0" KeyPath="yes" />
                </RegistryKey>
            </Component>

            <!-- ============================================================= -->
            <!-- Generic fallback icon for any file opened with AeroFTP         -->
            <!-- (Applications\aeroftp.exe\DefaultIcon = no-badge document)     -->
            <!-- ============================================================= -->

            <Component Id="AeroFTPAppDefaultIcon" Guid="291E13E0-DAC0-430B-8FB2-1FB633A3D513" Win64="$(var.Win64)">
                <RegistryKey Root="HKMU" Key="Software\Classes\Applications\aeroftp.exe\DefaultIcon" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="[INSTALLDIR]icons\mimetypes\aeroftp-document.ico,0" KeyPath="yes" />
                </RegistryKey>
            </Component>

        </ComponentGroup>
    </Fragment>
</Wix>
