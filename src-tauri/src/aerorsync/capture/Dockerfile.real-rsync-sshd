FROM debian:bookworm-slim
# bookworm carries rsync 3.2.7 (advertising protocol 32 on recent
# security-patch releases). trixie ships rsync 3.4.x, also protocol 32.
# The host-side rsync we use as client speaks protocol 31 on older Ubuntu
# LTS releases and protocol 32 on newer ones, so we pin the client
# invocation to `--protocol=31` in `run_real_rsync_capture.sh` to obtain
# a byte-oracle stable across dev machines. The Dockerfile itself only
# needs a rsync that understands protocol 31, which bookworm does.

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        openssh-server \
        python3 \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# testuser's uid decides who owns everything `rsync --server` writes into the
# bind-mounted /workspace. It used to be whatever useradd picked, i.e. 1000.
#
# That silently scoped the whole RSNP_TEST_REAL lane to one account. The live
# tests seed their "remote" fixtures by writing straight into the host side of
# the mount, and the upload tests reseed between algorithms - so on a machine
# where the developer is not uid 1000, the first upload succeeds, rsync
# recreates the file owned by 1000 with mode 644, and the second iteration
# dies on PermissionDenied before sending a byte. Measured here 2026-07-28:
# uid 1001 got 6/8, with both upload tests failing that way.
#
# Passing the caller's uid makes the mount writable by the caller. The default
# stays 1000, so setups that already work are untouched.
ARG TESTUSER_UID=1000
ARG TESTUSER_GID=1000
RUN groupadd -g "${TESTUSER_GID}" testuser \
    && useradd -m -u "${TESTUSER_UID}" -g "${TESTUSER_GID}" -s /bin/bash testuser \
    && passwd -d testuser \
    && mkdir -p /var/run/sshd /home/testuser/.ssh /workspace /workspace/real_capture /opt/rsync-tee \
    && chmod 700 /home/testuser/.ssh \
    && chown -R testuser:testuser /home/testuser/.ssh /workspace

COPY sshd_config_real_rsync_ed25519.conf /etc/ssh/sshd_config
COPY rsync_server_wrapper.sh /opt/rsync-tee/rsync_server_wrapper.sh
COPY rsync_proxy.py /opt/rsync-tee/rsync_proxy.py
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /opt/rsync-tee/rsync_server_wrapper.sh /opt/rsync-tee/rsync_proxy.py

ENTRYPOINT ["/entrypoint.sh"]
