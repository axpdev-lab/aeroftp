FROM debian:bookworm-slim AS rsync-build

# The WD firmware peer that motivated this lane is limited to
# "zlibx zlib none". Build the last upstream pre-zstd release so this
# token oracle does not depend on an EOL Debian archive or on whatever
# rsync is installed on the runner.
ARG RSYNC_VERSION=3.1.3
ARG RSYNC_SHA256=55cc554efec5fdaad70de921cd5a5eeb6c29a95524c715f3bbf849235b0800c0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libpopt-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl -fsSLO --retry 4 --retry-delay 5 --retry-all-errors \
        "https://download.samba.org/pub/rsync/src/rsync-${RSYNC_VERSION}.tar.gz" \
    && echo "${RSYNC_SHA256}  rsync-${RSYNC_VERSION}.tar.gz" | sha256sum -c - \
    && tar -xzf "rsync-${RSYNC_VERSION}.tar.gz" \
    && cd "rsync-${RSYNC_VERSION}" \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install-strip

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        libpopt0 \
        openssh-server \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rsync-build /usr/local/bin/rsync /usr/local/bin/rsync

# Keep bind-mount ownership symmetric with the host. Without these build
# args a non-uid-1000 developer gets a green first transfer followed by
# PermissionDenied while reseeding the next case.
ARG TESTUSER_UID=1000
ARG TESTUSER_GID=1000
RUN groupadd -g "${TESTUSER_GID}" testuser \
    && useradd -m -u "${TESTUSER_UID}" -g "${TESTUSER_GID}" -s /bin/bash testuser \
    && passwd -d testuser \
    && mkdir -p /var/run/sshd /home/testuser/.ssh /workspace /workspace/deflate_capture /opt/rsync-tee \
    && chmod 700 /home/testuser/.ssh \
    && chown -R testuser:testuser /home/testuser/.ssh /workspace

COPY sshd_config_real_rsync_ed25519.conf /etc/ssh/sshd_config
COPY rsync_server_wrapper.sh /opt/rsync-tee/rsync_server_wrapper.sh
COPY rsync_proxy.py /opt/rsync-tee/rsync_proxy.py
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /opt/rsync-tee/rsync_server_wrapper.sh /opt/rsync-tee/rsync_proxy.py
RUN printf '%s\n' /workspace/deflate_capture > /etc/aeroftp-rsync-capture-root

ENTRYPOINT ["/entrypoint.sh"]
