# Generated by Cargo
# will have compiled files and executables
/target/
# Separate build dir for the ci_lane3 lane. RUSTFLAGS='--cfg ci_lane3' produces
# a different fingerprint, so sharing /target with a normal build makes the two
# invalidate each other and recompile the whole tree in turn.
/target-lane3/
/gen/schemas

# Local-only live test that exercises real AWS STS AssumeRole with the
# owner's credentials. Must never be committed (no secrets in the repo).
/tests/live_sts_assume_role.rs
