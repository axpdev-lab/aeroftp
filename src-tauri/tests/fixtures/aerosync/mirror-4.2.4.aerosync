{
  "schema_version": 1,
  "name": "Site mirror 4.2.4",
  "description": "Exported before Plan modes were explicit",
  "created_by": "AeroFTP v4.2.4",
  "path_patterns": [
    {
      "local": "/home/u/site",
      "remote": "/www/site"
    }
  ],
  "profile": {
    "direction": "local_to_remote",
    "compare_timestamp": true,
    "compare_size": true,
    "compare_checksum": false,
    "delete_orphans": true,
    "parallel_streams": 1,
    "compression_mode": "off",
    "verify_policy": "size_only"
  },
  "exclude_patterns": [
    "*.tmp",
    "cache/"
  ],
  "schedule": null
}
